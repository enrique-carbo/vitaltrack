# .npmrc - Configuración de Máxima Seguridad

# === Seguridad de Supply Chain ===
# Previene instalación de paquetes modificados
package-lock-strict=true

# Evita instalación automática de peer dependencies potencialmente vulnerables
auto-install-peers=false

# Convierte warnings de peer dependencies en errores
strict-peer-dependencies=true

# === Protección adicional ===
# Solo permite paquetes con integridad verificable
resolution-mode=highest

# No permite cambios en lockfile sin confirmación manual
prefer-frozen-lockfile=true

# Verifica integridad de paquetes contra el lockfile
side-effects-cache=false

# === Cuarentena ===
# Bloquea paquetes publicados hace menos de 24 horas
minimum-release-age=1440

# === Seguridad de red ===
# Solo usa HTTPS para el registry
strict-ssl=true

# === Control de versiones ===
# No permite paquetes sin versión específica
save-exact=true
