---
import Layout from "@/layouts/Layout.astro";
import DailyLogger from "@/components/DailyLogger";
import "@/styles/global.css";
---

<Layout title="Registro Diario - VitalTrack">
    <main class="max-w-4xl mx-auto p-4 md:p-8 animate-fade-in">
        <header class="mb-8">
            <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
                Buen día, Usuario
            </h1>
            <p class="text-slate-500 mt-2">
                Registra tus variables clínicas hoy. Los datos se guardarán
                offline en tu dispositivo.
            </p>
        </header>

        <!-- ISLAND DE INTERACTIVIDAD -->
        <DailyLogger client:load />
    </main>
</Layout>
