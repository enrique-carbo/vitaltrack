---
import Layout from "@/layouts/Layout.astro";
import {
    Shield,
    Database,
    FileText,
    Cloud,
    Printer,
    AlertTriangle,
    Heart,
    Pill,
    Activity,
    Calendar,
} from "lucide-react";
import "@/styles/global.css";
---

<Layout title="Guía del Paciente - VitalTrack">
    <main class="max-w-4xl mx-auto p-4 md:p-8">
        {/* Header */}
        <div class="text-center mb-10">
            <div
                class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4"
            >
                <Heart className="w-8 h-8 text-blue-600" />
            </div>
            <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900">
                Guía del Paciente
            </h1>
            <p class="text-slate-500 mt-3 max-w-2xl mx-auto">
                Todo lo que necesitas saber para usar VitalTrack de manera
                segura y efectiva
            </p>
        </div>

        {/* Sección 1: ¿Qué es VitalTrack? */}
        <div class="bg-white rounded-xl border border-slate-200 p-6 mb-6 mt-6">
            <div class="flex items-center gap-3 mb-4">
                <Activity className="w-6 h-6 text-blue-600" />
                <h2 class="text-xl font-bold text-slate-800">
                    ¿Qué es VitalTrack?
                </h2>
            </div>
            <p class="text-slate-600 leading-relaxed">
                VitalTrack es un <strong>diario clínico digital</strong> diseñado
                para pacientes con condiciones crónicas (diabetes, hipertensión, etc.).
                Te permite registrar tus variables clínicas diarias y controlar la
                adherencia a tus medicamentos, transformando el tradicional "cuaderno
                de papel" en informes profesionales que puedes compartir con tu médico.
            </p>
        </div>

        {/* Sección 2: Tus datos son 100% privados */}
        <div class="bg-green-50 border border-green-200 rounded-xl p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <Shield className="w-6 h-6 text-green-700" />
                <h2 class="text-xl font-bold text-green-800">
                    🔒 Tus datos son 100% privados
                </h2>
            </div>
            <div class="space-y-3 text-green-800">
                <p class="flex items-start gap-2">
                    <span class="text-green-600 font-bold">✓</span>
                    <span
                        ><strong>Zero-Backend:</strong> No hay servidores, no hay
                        cuentas, no hay nube. Tus datos NUNCA salen de tu dispositivo.</span
                    >
                </p>
                <p class="flex items-start gap-2">
                    <span class="text-green-600 font-bold">✓</span>
                    <span
                        ><strong>Base de Datos local:</strong> Toda la información
                        se almacena exclusivamente en tu navegador.</span
                    >
                </p>
                <p class="flex items-start gap-2">
                    <span class="text-green-600 font-bold">✓</span>
                    <span
                        ><strong>Sin rastreo:</strong> No recopilamos métricas, no
                        usamos analytics, no hay publicidad.</span
                    >
                </p>
                <p class="flex items-start gap-2">
                    <span class="text-green-600 font-bold">✓</span>
                    <span
                        ><strong>Offline-first:</strong> La app funciona sin conexión
                        a internet.</span
                    >
                </p>
            </div>
        </div>

        {/* Sección 3: Funcionalidades principales */}
        <div class="bg-white rounded-xl border border-slate-200 p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <Pill className="w-6 h-6 text-blue-600" />
                <h2 class="text-xl font-bold text-slate-800">
                    Funcionalidades principales
                </h2>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-lg">
                    <FileText className="w-5 h-5 text-blue-600 mt-0.5" />
                    <div>
                        <h3 class="font-semibold text-slate-800">
                            Registro clínico
                        </h3>
                        <p class="text-sm text-slate-500">
                            Glucosa, presión arterial, peso, frecuencia
                            cardíaca, saturación de oxígeno...
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-lg">
                    <Pill className="w-5 h-5 text-blue-600 mt-0.5" />
                    <div>
                        <h3 class="font-semibold text-slate-800">
                            Medicamentos
                        </h3>
                        <p class="text-sm text-slate-500">
                            Control diario de adherencia a tu tratamiento.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-lg">
                    <Activity className="w-5 h-5 text-blue-600 mt-0.5" />
                    <div>
                        <h3 class="font-semibold text-slate-800">
                            Gráficos de tendencia
                        </h3>
                        <p class="text-sm text-slate-500">
                            Visualiza la evolución de tus variables clínicas.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3 p-3 bg-slate-50 rounded-lg">
                    <Printer className="w-5 h-5 text-blue-600 mt-0.5" />
                    <div>
                        <h3 class="font-semibold text-slate-800">
                            Reportes para el médico
                        </h3>
                        <p class="text-sm text-slate-500">
                            Informes profesionales listos para imprimir o
                            guardar como PDF.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        {/* Sección 4: Responsabilidad del paciente */}
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <AlertTriangle className="w-6 h-6 text-amber-700" />
                <h2 class="text-xl font-bold text-amber-800">
                    ⚠️ Tu responsabilidad: Hacer respaldos
                </h2>
            </div>

            <div class="space-y-4 text-amber-800">
                <p class="font-semibold">
                    Tus datos viven SOLO en este dispositivo. Si pierdes el
                    navegador, limpias la caché o cambias de teléfono,
                    <span class="font-bold underline">
                        perderás todos tus registros</span
                    >.
                </p>

                <div class="bg-white rounded-lg p-4">
                    <p class="font-bold mb-2">
                        📋 Rutina recomendada: <span class="text-amber-700"
                            >Una vez por semana</span
                        >
                    </p>
                    <ol class="list-decimal list-inside space-y-1 text-sm ml-2">
                        <li>
                            Genera el <strong>Reporte de Salud</strong> (variables
                            clínicas)
                        </li>
                        <li>
                            Genera el <strong>Reporte de Adherencia</strong> (medicamentos)
                        </li>
                        <li>Guarda ambos como PDF en tu computadora</li>
                        <li>
                            Opcional: súbelos a tu nube personal (Google Drive,
                            Dropbox, etc.)
                        </li>
                        <li>
                            Comparte los informes con tu médico en la consulta
                        </li>
                    </ol>
                </div>

                <div class="flex items-start gap-2 text-sm">
                    <span class="text-amber-700 font-bold">💡 Consejo:</span>
                    <span
                        >Si tienes varios meses de registro, genera un reporte
                        por mes y guárdalos organizados.</span
                    >
                </div>
            </div>
        </div>

        {/* Sección 5: Cómo generar los reportes */}
        <div class="bg-white rounded-xl border border-slate-200 p-6 mb-6">
            <div class="flex items-center gap-3 mb-4">
                <FileText className="w-6 h-6 text-blue-600" />
                <h2 class="text-xl font-bold text-slate-800">
                    Cómo generar tus reportes
                </h2>
            </div>

            <div class="space-y-4">
                <div class="border-b border-slate-100 pb-3">
                    <h3 class="font-bold text-slate-700">
                        📊 Reporte de Salud (Variables clínicas)
                    </h3>
                    <ol
                        class="list-decimal list-inside text-sm text-slate-600 ml-4 mt-1 space-y-1"
                    >
                        <li>
                            Ve a <strong>Inicio → Reporte PDF</strong>
                        </li>
                        <li>
                            Selecciona la categoría que deseas (Todas,
                            Metabólicas, Cardiología, etc.)
                        </li>
                        <li>
                            Haz clic en <strong
                                >"Imprimir / Guardar PDF / PDF"</strong
                            >
                        </li>
                        <li>
                            En el diálogo de impresión, elige <strong
                                >"Guardar como PDF"</strong
                            >
                        </li>
                        <li>
                            Guarda el archivo con nombre claro (ej:
                            "salud_enero_2026.pdf")
                        </li>
                    </ol>
                </div>

                <div>
                    <h3 class="font-bold text-slate-700">
                        💊 Reporte de Adherencia (Medicamentos)
                    </h3>
                    <ol
                        class="list-decimal list-inside text-sm text-slate-600 ml-4 mt-1 space-y-1"
                    >
                        <li>
                            Ve a <strong>Medicamentos → Reporte</strong>
                        </li>
                        <li>Selecciona el mes que deseas reportar</li>
                        <li>
                            Haz clic en <strong
                                >"Imprimir Reporte / PDF"</strong>
                        </li>
                        <li>
                            En el diálogo de impresión, elige <strong
                                >"Guardar como PDF"</strong
                            >
                        </li>
                        <li>
                            Guarda el archivo (ej: "adherencia_enero_2026.pdf")
                        </li>
                    </ol>
                </div>
            </div>
        </div>

        {/* Sección 6: Recomendaciones */}
        <div class="bg-blue-50 border border-blue-200 rounded-xl p-6 mb-6">
            <div class="flex items-center gap-3 mb-3">
                <Calendar className="w-5 h-5 text-blue-600" />
                <h2 class="text-lg font-bold text-blue-800">
                    📅 Recomendaciones de uso
                </h2>
            </div>
            <ul class="space-y-2 text-blue-800 text-sm">
                <li class="flex items-start gap-2">
                    • Registra tus variables clínicas <strong>a diario</strong> para
                    ver tendencias reales
                </li>
                <li class="flex items-start gap-2">
                    • Marca tus medicamentos apenas los tomes, para no olvidar
                </li>
                <li class="flex items-start gap-2">
                    • Programa un recordatorio semanal para generar y guardar
                    tus PDF
                </li>
                <li class="flex items-start gap-2">
                    • Lleva los reportes impresos
                </li>
                <li class="flex items-start gap-2">
                    • Si cambias de dispositivo, deberás comenzar de cero (por
                    eso son importantes los respaldos)
                </li>
            </ul>
        </div>

        {/* Footer con aviso médico */}
        <div
            class="text-center text-sm text-slate-800 border border-slate-800 p-6 mt-4"
        >
            <p>
                ⚠️ <strong>Aviso Médico: </strong>VitalTrack es una herramienta
                de registro personal.
            </p>
            <p>
                No sustituye el consejo, diagnóstico o tratamiento médico
                profesional.
            </p>
            <p class="mt-2 font-bold">
                Siempre consulta a tu médico ante cualquier duda sobre tu salud.
            </p>
        </div>
    </main>
</Layout>
