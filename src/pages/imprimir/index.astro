---
import Layout from "@/layouts/Layout.astro";
import { db } from "@/db/db";
import { CLINICAL_VARIABLES, getVariableById } from "../../config/variables";
import { formatTimestamp } from "../../utils/date";

import PrintReportData from "@/components/PrintReportData";
import "@/styles/print.css";
---

<Layout title="Reporte Médico - VitalTrack">
    <!-- Clase no-print para que el botón NO salga en el PDF -->
    <div class="max-w-5xl mx-auto p-6 md:p-8 no-print">
        <div
            class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6 flex items-center justify-between"
        >
            <div>
                <h2 class="text-blue-900 font-bold">
                    Generar Informe para el Médico
                </h2>
                <p class="text-blue-700 text-sm">
                    Este reporte contiene todos tus registros históricos en
                    formato de tabla.
                </p>
            </div>
            <button
                onclick="window.print()"
                class="bg-blue-600 text-white px-6 py-3 rounded-lg font-bold shadow hover:bg-blue-700 transition flex items-center gap-2"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M6 9V2h12v7"></path><path
                        d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                    ></path><path d="M6 14h12v8H6z"></path></svg
                >
                Imprimir / Guardar PDF
            </button>
        </div>
    </div>

    <!-- Contenedor Real del Reporte -->
    <div
        class="max-w-5xl mx-auto p-0 md:p-8 bg-white shadow-sm min-h-screen border border-gray-200 rounded-xl overflow-hidden"
    >
        <!-- Header del Documento -->
        <div class="print-header p-6 bg-white">
            <div class="flex justify-between items-start">
                <div>
                    <h1 class="text-3xl font-bold text-black tracking-tight">
                        Informe de Salud
                    </h1>
                    <p class="text-gray-600 mt-1">
                        VitalTrack - Historial Clínico Personal
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-sm font-bold text-gray-900">
                        Fecha de Impresión:
                    </p>
                    <p class="text-sm text-gray-600 font-mono">
                        {new Date().toLocaleDateString()}
                    </p>
                </div>
            </div>
        </div>

        <!-- Tabla de Datos Generada por React (para acceder a IndexedDB) -->
        <div class="p-6">
            <PrintReportData client:load />
        </div>

        <!-- Footer del Documento -->
        <div
            class="p-6 text-center border-t border-gray-200 mt-8 text-xs text-gray-500 print-footer"
        >
            <p>
                Este documento ha sido generado por VitalTrack (Diario Clínico
                Personal). Los datos provienen del almacenamiento local del
                dispositivo.
            </p>
            <p class="mt-1">
                Solo para uso informativo. No sustituye la opinión médica
                profesional.
            </p>
        </div>
    </div>
</Layout>
