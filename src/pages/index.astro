---
import Layout from "@/layouts/Layout.astro";
import DashboardList from "@/components/DashboardList";
import UserProfile from "@/components/UserProfile";
import { Printer } from "lucide-react";
import "@/styles/global.css";
---

<Layout title="Inicio - VitalTrack">
    <main class="max-w-4xl mx-auto p-4 md:p-8">
        <div class="flex justify-between items-start gap-3 mb-6 md:mb-8">
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900">
                    Resumen de Salud
                </h1>
                <p class="text-slate-500 text-sm md:text-base mt-1 md:mt-2">
                    Tus datos más recientes
                </p>
            </div>
            <a
                href="/imprimir"
                class="inline-flex items-center justify-center gap-2 px-3 py-2 md:px-5 md:py-2.5 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 transition-all duration-200 shadow-sm hover:shadow"
                title="Generar reporte médico"
            >
                <Printer size={18} className="md:w-5 md:h-5" />
                <span class="hidden md:inline">Reporte PDF</span>
            </a>
        </div>

        <UserProfile client:load />
        <DashboardList client:load />
    </main>
</Layout>
