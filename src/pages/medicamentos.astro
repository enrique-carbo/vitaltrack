---
import Layout from "@/layouts/Layout.astro";
import MedManager from "@/components/MedManager";
import MedicationLog from "@/components/MedicationLog";
import MedicationHistory from "@/components/MedicationHistory";
import { FileText } from "lucide-react";
import "@/styles/global.css";
---

<Layout title="Medicamentos - VitalTrack">
    <main class="max-w-5xl mx-auto p-4 md:p-8">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900">
                    Mis Medicamentos
                </h1>
                <p class="text-slate-500 text-sm mt-1">
                    Controla la adherencia a tu tratamiento diario.
                </p>
            </div>
            <a
                href="/adherencia"
                class="inline-flex items-center gap-2 px-3 py-2 bg-green-600 text-white rounded-lg text-sm font-medium hover:bg-green-700 transition"
            >
                <FileText size={16} />
                Reporte
            </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <MedManager client:load />
                <div class="flex items-center gap-2 mt-4">
                    <div class="h-px bg-slate-200 grow"></div>
                    <span
                        class="text-xs font-bold text-slate-400 uppercase tracking-wider"
                    >
                        Plan de hoy
                    </span>
                    <div class="h-px bg-slate-200 grow"></div>
                </div>
                <MedicationLog client:load />
            </div>
            <div class="lg:col-span-1">
                <MedicationHistory client:load />
            </div>
        </div>
    </main>
</Layout>
